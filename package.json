{
  "name": "clavix",
  "version": "0.26.2",
  "description": "Client desktop moderne pour Vaultwarden/Bitwarden",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "bindings": "TS_RS_EXPORT_DIR=\"$PWD/src/lib/generated\" cargo test --manifest-path src-tauri/Cargo.toml --workspace export_bindings",
    "check": "pnpm run paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "pnpm run paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "pnpm run paraglide && vitest run",
    "test:watch": "pnpm run paraglide && vitest",
    "test:e2e": "wdio run tests/e2e/wdio.conf.mjs",
    "build:e2e": "tauri build --debug --no-bundle --config src-tauri/tauri.e2e.conf.json",
    "tauri": "tauri"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@inlang/paraglide-js": "^2.29.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.5",
    "@wdio/cli": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "jsdom": "^30.1.3",
    "jsqr": "^1.4.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "~5.6.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
